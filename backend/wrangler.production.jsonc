{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Candidate RC deployment config only. This is not yet cleared for deploy.
  // The live version reports base_path "/", serve_directly=true,
  // raw_run_worker_first=false, html_handling=auto-trailing-slash, and
  // not_found_handling=none. RC backend/public contains the hash-verified root
  // HTML, but the production asset manifest and any other assets remain unverified.
  "name": "cloudflare-api",
  // RC entrypoint (src/index.ts); the original production module filename is
  // not exposed by the read-only Worker metadata and therefore is unverified.
  "main": "src/index.ts",
  "account_id": "f17c675f86cd6f9116a15f5b0f1ab86e",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "./public",
    "base_path": "/",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": false
  },
  "workers_dev": true,
  "preview_urls": true,
  "triggers": {
    "crons": ["*/1 * * * *"]
  },
  "logpush": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false
    }
  },
  // The live Worker has no plain-text vars. Do not copy LOCAL_DEV from RC tests.
  "vars": {},
  // Names only; values remain Cloudflare Secrets and are never stored here.
  "secrets": {
    "required": [
      "VAPID_PRIVATE_KEY",
      "VAPID_PUBLIC_KEY",
      "VAPID_SUBJECT"
    ]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "money-app-shared",
    "database_id": "142e6c05-b703-4825-828b-b6dd702c38bd"
  }]
  // migrations_dir intentionally omitted: this file is for Worker deployment
  // only, not D1 migration operations. Use the separately reviewed 0012-only
  // migration config for any explicitly approved migration work.
  // The live account reports usage_model=standard, which this Wrangler schema
  // does not expose as a configurable field. Recheck it before any deployment.
}
